  } catch(err){
    hideTyping();
    addMsg('bot','⚡ Connection issue. Please call us at **+91 89823 79366** or WhatsApp for instant help!');
  }
  isBotTyping = false;
}

function extractHints(msg){
  var ph = msg.match(/[6-9]\d{9}/); if(ph) pendingData.phone=ph[0];
  var bill = msg.match(/(?:bill|₹|rs\.?)\s*(\d{3,6})/i); if(bill) pendingData.bill=parseInt(bill[1]);
  var bnum = msg.match(/(\d{4,6})\s*(?:rs|rupees|₹|month|\/month)/i); if(bnum) pendingData.bill=parseInt(bnum[1]);
  var units = msg.match(/(\d{2,4})\s*(?:unit|kwh)/i); if(units) pendingData.units=parseInt(units[1]);
  var area = msg.match(/(\d{3,5})\s*(?:sqft|sq\.?\s*ft|square\s*feet)/i); if(area) pendingData.area=parseInt(area[1]);
  var cuts = msg.match(/(\d+)\s*(?:power\s*cut|cut|time|बार)\s*(?:per|a)?\s*day/i); if(cuts) pendingData.cuts=parseInt(cuts[1]);
}

