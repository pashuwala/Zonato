function renderPipeline(){
  var stageDefs = [
    {id:'pl0', cid:'pc0', key:'new', statuses:['cold']},
    {id:'pl1', cid:'pc1', key:'contacted', statuses:[]},
    {id:'pl2', cid:'pc2', key:'warm', statuses:['warm']},
    {id:'pl3', cid:'pc3', key:'hot', statuses:['hot']},
    {id:'pl4', cid:'pc4', key:'converted', statuses:['converted']}
  ];
  stageDefs.forEach(function(s, si){
    var items;
    if(s.key==='new'){
      items = leads.filter(function(l){return l.stage==='new'||(!l.stage && l.status==='cold');});
    } else if(s.key==='contacted'){
      items = leads.filter(function(l){return l.stage==='contacted';});
    } else {
      items = leads.filter(function(l){return l.status===s.key||(s.statuses.length&&s.statuses.indexOf(l.status)>-1 && l.stage!=='new');});
    }
    document.getElementById(s.cid).textContent = items.length;
    var container = document.getElementById(s.id);
    if(!container) return;
    if(!items.length){container.innerHTML='<div style="font-size:11px;color:var(--muted);padding:6px;">Empty</div>';return;}
    container.innerHTML = items.map(function(l){
      return '<div class="p-card" onclick="gotoView(\'crm\',null);viewLead(\''+l.id+'\')">'+
        '<div class="pcn">'+esc(l.name)+'</div>'+
        '<div class="pci">📍 '+esc(l.location)+'</div>'+
        '<div class="pcv">₹'+fmt(l.cost)+'</div>'+
      '</div>';
    }).join('');
  });
}

function renderAnalytics(){
  if(!leads.length){
    ['a1','a2','a3','a4'].forEach(function(id){document.getElementById(id).textContent='—';});
    return;
  }
  var totalC = leads.reduce(function(s,l){return s+(l.cost||0);},0);
  var totalK = leads.reduce(function(s,l){return s+(l.kw||0);},0);
  var conv = leads.filter(function(l){return l.status==='converted';}).length;
  var cities = new Set(leads.map(function(l){return (l.location||'').split(',')[0].trim();})).size;
  document.getElementById('a1').textContent = '₹'+(totalC/leads.length/100000).toFixed(1)+'L';
  document.getElementById('a2').textContent = (totalK/leads.length).toFixed(1);
  document.getElementById('a3').textContent = Math.round(conv/leads.length*100)+'%';
  document.getElementById('a4').textContent = cities;

  // System type
  var sysCnt = {};
  leads.forEach(function(l){var k=(l.systype||'Unknown').substring(0,18);sysCnt[k]=(sysCnt[k]||0)+1;});
  var maxS = Math.max.apply(null,Object.values(sysCnt));
  document.getElementById('ch1').innerHTML = Object.entries(sysCnt).map(function(e){
    return '<div class="bar-r"><div class="bar-lbl">'+e[0]+'</div><div class="bar-trk"><div class="bar-fl" style="width:'+Math.round(e[1]/maxS*100)+'%"></div></div><div class="bar-v">'+e[1]+'</div></div>';
  }).join('');

  // Status
  var stCnt = {hot:0,warm:0,cold:0,converted:0};
  leads.forEach(function(l){stCnt[l.status]=(stCnt[l.status]||0)+1;});
  var stColors = {hot:'var(--red)',warm:'var(--amber)',cold:'var(--blue)',converted:'var(--green)'};
  document.getElementById('ch2').innerHTML = Object.entries(stCnt).filter(function(e){return e[1]>0;}).map(function(e){
    return '<div style="display:flex;align-items:center;gap:8px;margin-bottom:7px;"><div style="width:10px;height:10px;border-radius:50%;background:'+stColors[e[0]]+';flex-shrink:0;"></div><span style="font-size:12px;color:var(--text);">'+e[0].toUpperCase()+': '+e[1]+'</span></div>';
  }).join('');

  // Bill range
  var br = {'<₹1k':0,'₹1-3k':0,'₹3-5k':0,'₹5-10k':0,'>₹10k':0};
  leads.forEach(function(l){
    if((l.bill||0)<1000)br['<₹1k']++;
    else if(l.bill<3000)br['₹1-3k']++;
    else if(l.bill<5000)br['₹3-5k']++;
    else if(l.bill<10000)br['₹5-10k']++;
    else br['>₹10k']++;
  });
  var maxB = Math.max.apply(null,Object.values(br));
  document.getElementById('ch3').innerHTML = Object.entries(br).map(function(e){
    return '<div class="bar-r"><div class="bar-lbl">'+e[0]+'</div><div class="bar-trk"><div class="bar-fl" style="width:'+Math.round(e[1]/Math.max(maxB,1)*100)+'%"></div></div><div class="bar-v">'+e[1]+'</div></div>';
  }).join('');

  // Locations
  var locCnt = {};
  leads.forEach(function(l){var k=(l.location||'').split(',')[0].trim();locCnt[k]=(locCnt[k]||0)+1;});
  var top5 = Object.entries(locCnt).sort(function(a,b){return b[1]-a[1];}).slice(0,5);
  var maxL = top5.length?top5[0][1]:1;
  document.getElementById('ch4').innerHTML = top5.length?top5.map(function(e){
    return '<div class="bar-r"><div class="bar-lbl">'+e[0]+'</div><div class="bar-trk"><div class="bar-fl" style="width:'+Math.round(e[1]/maxL*100)+'%"></div></div><div class="bar-v">'+e[1]+'</div></div>';
  }).join(''):'<span style="color:var(--muted);font-size:12px;">No data</span>';
}

