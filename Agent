        <table>
          <thead><tr>
            <th>#</th><th>Name</th><th>Location</th><th>Phone</th>
            <th>Bill/Mo</th><th>Units</th><th>Sanction kW</th><th>Area sqft</th>
            <th>Cuts/Day</th><th>System</th><th>Size kW</th><th>Est Cost</th>
            <th>Savings/Yr</th><th>ROI</th><th>Score</th><th>Status</th><th>Actions</th>
          </tr></thead>
