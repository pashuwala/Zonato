function doneFU(i){
  var fus=JSON.parse(localStorage.getItem('zs_fus')||'[]');
  if(fus[i])fus[i].done=true;
  localStorage.setItem('zs_fus',JSON.stringify(fus));
  renderFU();
}
function delFU(i){
  var fus=JSON.parse(localStorage.getItem('zs_fus')||'[]');
  fus.splice(i,1);
  localStorage.setItem('zs_fus',JSON.stringify(fus));
  renderFU();
}

function delLead(id){
  if(!confirm('Delete this lead?'))return;
  leads=leads.filter(function(l){return String(l.id)!==String(id);});
  saveLeads();
  refreshKPIs();
  renderLeads(leads);
  var panel=document.getElementById('ldPanel');
  if(panel)panel.classList.remove('on');
}

function cycleStatus(id){
  var l=leads.find(function(x){return String(x.id)===String(id);});
  if(!l)return;
  var order=['cold','warm','hot','converted'];
  var idx=order.indexOf(l.status);
  l.status=order[(idx+1)%order.length];
  l.score=scoreCalc(l.bill,l.cuts,l.status);
  saveLeads();
  refreshKPIs();
  renderLeads(leads);
  viewLead(id);
}

function markConverted(id){
  var l=leads.find(function(x){return String(x.id)===String(id);});
  if(!l)return;
  l.status='converted';l.score=99;l.stage='converted';
  saveLeads();
  refreshKPIs();
  renderLeads(leads);
  viewLead(id);
  alert('🎉 '+l.name+' marked CONVERTED! Deal: ₹'+fmt(l.cost));
}

function filterLeads(q){
  if(!q){renderLeads(leads);return;}
  q=q.toLowerCase();
  var f=leads.filter(function(l){
    return (l.name||'').toLowerCase().includes(q)||
           (l.location||'').toLowerCase().includes(q)||
           (l.phone||'').includes(q)||
           (l.status||'').includes(q);
  });
  renderLeads(f);
}

function exportCSV(){
  if(!leads.length){alert('No leads to export.');return;}
  var hdrs=['Name','Phone','Email','Location','Bill','Units','SanctionKW','Area','Cuts/Day','SystemType','SystemKW','EstCost','AnnualSavings','ROI','Score','Status','Date'];
  var rows=leads.map(function(l){
    return [l.name,l.phone,l.email,l.location,l.bill,l.units,l.sanctload,l.area,l.cuts,l.systype,l.kw,l.cost,l.annSav,l.roi,l.score,l.status,l.date]
      .map(function(v){return '"'+(v||'')+'"';}).join(',');
  });
  var csv=[hdrs.join(',')].concat(rows).join('\n');
  var a=document.createElement('a');
  a.href='data:text/csv;charset=utf-8,'+encodeURIComponent(csv);
  a.download='ZonatoSolar_Leads_'+new Date().toISOString().slice(0,10)+'.csv';
  a.click();
}

