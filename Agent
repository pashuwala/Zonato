  var units = parseFloat(document.getElementById('f_units').value)||0;
  var cuts = parseFloat(document.getElementById('f_cuts').value)||0;
  var cutdur = parseFloat(document.getElementById('f_cutdur').value)||0;
  var tariff = parseFloat(document.getElementById('f_tariff').value)||6.5;
  var sysv = document.getElementById('f_sysopt').value;
  var type = sysv==='hybrid'?'hybrid':'offgrid';
  var status = document.getElementById('f_status').value;
  var r = calcSolar(bill,units,parseFloat(document.getElementById('f_area').value)||0,cuts,cutdur,tariff,type);

  var lead = {
    id: Date.now(),
    name:name, phone:phone,
    email: document.getElementById('f_email').value||'',
    location:location,
    address: document.getElementById('f_address').value||'',
    source: document.getElementById('f_source').value,
