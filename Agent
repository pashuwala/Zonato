function toggleFUForm(id){
  var el = document.getElementById(id);
  if(el) el.style.display = el.style.display==='block'?'none':'block';
}

function saveFollowUp(lid){
  var date = (document.getElementById('fud_'+lid)||{}).value;
  var time = (document.getElementById('fut_'+lid)||{}).value;
  var note = (document.getElementById('fun_'+lid)||{}).value||'Follow-up';
  if(!date||!time){alert('Please select date and time.');return;}
  var fus = JSON.parse(localStorage.getItem('zs_fus')||'[]');
  fus.push({lid:lid, date:date, time:time, note:note, done:false, id:Date.now()});
  localStorage.setItem('zs_fus', JSON.stringify(fus));
  toggleFUForm('fu_'+lid);
  alert('✅ Follow-up scheduled for '+date+' at '+time);
}

function renderFU(){
  var fus = JSON.parse(localStorage.getItem('zs_fus')||'[]');
  var el = document.getElementById('fuList');
  if(!fus.length){el.innerHTML='<div style="text-align:center;padding:40px;color:var(--muted);">No follow-ups yet. Open a lead and schedule one!</div>';return;}
  el.innerHTML = fus.map(function(f,i){
    var lead = leads.find(function(l){return String(l.id)===String(f.lid);});
    var nm = lead?lead.name:'Unknown';
    var loc = lead?lead.location:'';
    return '<div style="display:flex;align-items:center;gap:10px;padding:12px;border:1px solid '+(f.done?'rgba(34,197,94,0.15)':'rgba(232,28,28,0.12)')+';border-radius:3px;margin-bottom:8px;background:'+(f.done?'rgba(34,197,94,0.04)':'rgba(232,28,28,0.03)')+';flex-wrap:wrap;">'+
