    tariff:tariff, cuts:cuts, cutdur:cutdur,
    area: parseFloat(document.getElementById('f_area').value)||0,
    roof: document.getElementById('f_roof').value,
    prop: document.getElementById('f_prop').value,
    grid: document.getElementById('f_grid').value,
    systype: document.getElementById('f_sysopt').options[document.getElementById('f_sysopt').selectedIndex].text,
    systype_val: type,
    battery: document.getElementById('f_bat').value,
    budget: document.getElementById('f_budget').value,
    status:status,
    notes: document.getElementById('f_notes').value||'',
    airec: document.getElementById('f_airec').value||'',
    kw:r.kw, panels:r.panels, battKwh:r.battKwh, areaNeed:r.areaNeed,
    days:r.days, cost:r.cost, annSav:r.annSav, roi:r.roi,
    score: scoreCalc(bill,cuts,status),
    date: new Date().toLocaleDateString('en-IN'),
    stage:'new'
  };
  leads.unshift(lead);
  saveLeads();
  resetForm();
  goSec('leads',null);
