// ════════════════════════
//  SOLAR CALCULATOR ENGINE
// ════════════════════════
function calcSolar(bill, units, area, cuts, cutdur, tariff, type){
  tariff = tariff || 6.5;
  if(!units && bill) units = bill / tariff;
  if(!units) units = 0;
  var daily = units / 30;
  var kw = Math.ceil(daily / 5 * 10) / 10;
  if(kw < 0.5) kw = 0;
  var panels = Math.ceil(kw / 0.55);
  var areaNeed = Math.ceil(panels * 25);
  var battKwh = type==='offgrid' ? Math.ceil(daily*1.2*10)/10 : Math.ceil(daily*0.5*10)/10;
  var days = kw<=0?0: kw<=3?2: kw<=5?3: kw<=10?5: Math.ceil(kw/2);
  var cpkw = type==='offgrid'?85000:75000;
  var cost = Math.round(kw*cpkw + battKwh*12000);
  var annSav = Math.round(units*12*tariff*0.85);
  var roi = annSav>0? Math.round(cost/annSav*10)/10: 0;
  var backHrs = (cuts&&cutdur)? cuts*cutdur: 6;
  return {kw:kw, panels:panels, areaNeed:areaNeed, battKwh:battKwh, days:days, cost:cost, annSav:annSav, roi:roi, backHrs:backHrs, daily:daily};
}

function autoCalc(){
  var bill = parseFloat(document.getElementById('f_bill').value)||0;
  var units = parseFloat(document.getElementById('f_units').value)||0;
  var area = parseFloat(document.getElementById('f_area').value)||0;
  var cuts = parseFloat(document.getElementById('f_cuts').value)||0;
  var cutdur = parseFloat(document.getElementById('f_cutdur').value)||0;
  var tariff = parseFloat(document.getElementById('f_tariff').value)||6.5;
  var sysv = document.getElementById('f_sysopt').value;
  var type = sysv==='hybrid'?'hybrid':'offgrid';
  if(!bill && !units) return;
  var r = calcSolar(bill,units,area,cuts,cutdur,tariff,type);
  document.getElementById('co_kw').textContent = r.kw?r.kw+' kW':'—';
  document.getElementById('co_pan').textContent = r.panels?r.panels+' Nos':'—';
  document.getElementById('co_batt').textContent = r.battKwh?r.battKwh+' kWh':'—';
  document.getElementById('co_areaq').textContent = r.areaNeed?r.areaNeed+' sqft':'—';
  document.getElementById('co_days').textContent = r.days?r.days+' Days':'—';
  document.getElementById('co_cost').textContent = r.cost?'₹'+r.cost.toLocaleString('en-IN'):'—';
  document.getElementById('co_save').textContent = r.annSav?'₹'+r.annSav.toLocaleString('en-IN'):'—';
  document.getElementById('co_roi').textContent = r.roi?r.roi+' Yrs':'—';
  document.getElementById('co_back').textContent = r.backHrs?r.backHrs+' Hrs':'—';
  // AI Recommendation
  var rec = buildRec(r, cuts, type, bill, area, r.areaNeed);
  document.getElementById('f_airec').value = rec;
}

function buildRec(r, cuts, type, bill, area, areaNeed){
  if(!r.kw) return '';
  var sys = type==='offgrid'?'Offgrid Solar':'Hybrid Solar';
  var lines = [];
  lines.push('✅ ZONATO SOLAR AI RECOMMENDATION');
  lines.push('System: '+sys+' — '+r.kw+' kW with '+r.battKwh+' kWh LiFePO4 Lithium Battery');
  lines.push('Panels: '+r.panels+' × 550W | Install: '+r.days+' days');
  lines.push('Cost: ₹'+r.cost.toLocaleString('en-IN')+' | Annual Savings: ₹'+r.annSav.toLocaleString('en-IN')+' | ROI: '+r.roi+' years');
  if(cuts>2) lines.push('⚡ '+cuts+' power cuts/day — Offgrid system is the ideal choice for 100% backup.');
  if(bill>5000) lines.push('💰 High bill ₹'+bill+'/month — strong financial motivation to convert.');
  if(area && areaNeed && area<areaNeed) lines.push('⚠️ Area '+area+'sqft may be short (need '+areaNeed+'sqft) — discuss ground mount or smaller system.');
  lines.push('\n🎯 Next Step: Schedule free site visit. Call +91 89823 79366.');
  return lines.join('\n');
}

function scoreCalc(bill, cuts, status){
  var s = 0;
  if(bill>8000)s+=35; else if(bill>5000)s+=25; else if(bill>3000)s+=15; else if(bill>1000)s+=8;
  if(cuts>5)s+=30; else if(cuts>3)s+=20; else if(cuts>1)s+=10;
  if(status==='hot')s+=30; else if(status==='warm')s+=15; else if(status==='converted')s=99;
  return Math.min(s,99);
}

