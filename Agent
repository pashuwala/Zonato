        </table>
      </div>
      <div class="ld-panel" id="ldPanel"></div>
    </div>

    <!-- ADD LEAD -->
    <div class="csec" id="sec-add">
      <div class="sec-hdr"><h2>ADD <span>NEW LEAD</span></h2><button class="btn btn-o" onclick="goSec('leads',null)">← Back</button></div>
      <div class="card-box">
        <div class="fgrid">
          <div class="fsec-ttl">👤 Customer Information</div>
          <div class="fg"><label>Full Name *</label><input id="f_name" placeholder="Customer full name"/></div>
          <div class="fg"><label>Phone Number *</label><input id="f_phone" placeholder="+91 XXXXX XXXXX"/></div>
          <div class="fg"><label>Email</label><input id="f_email" type="email" placeholder="email@example.com"/></div>
          <div class="fg"><label>Location / City *</label><input id="f_location" placeholder="City, District, State"/></div>
          <div class="fg"><label>Full Address</label><input id="f_address" placeholder="House, Street, Area"/></div>
          <div class="fg"><label>Lead Source</label>
            <select id="f_source"><option>AI Bot Chat</option><option>WhatsApp</option><option>Phone Call</option><option>Walk-in</option><option>Referral</option><option>Website Form</option><option>Social Media</option></select></div>

          <div class="fsec-ttl">⚡ Electricity & Consumption Details</div>
          <div class="fg"><label>Monthly Electricity Bill (₹) *</label><input id="f_bill" type="number" placeholder="e.g. 3500" oninput="autoCalc()"/></div>
          <div class="fg"><label>Units Consumed / Month (kWh)</label><input id="f_units" type="number" placeholder="e.g. 350" oninput="autoCalc()"/></div>
          <div class="fg"><label>Sanctioned Load by DISCOM (kW)</label><input id="f_sanctload" type="number" step="0.5" placeholder="e.g. 5"/></div>
          <div class="fg"><label>Current Tariff Rate (₹/unit)</label><input id="f_tariff" type="number" step="0.1" placeholder="e.g. 6.5" oninput="autoCalc()"/></div>
          <div class="fg"><label>Power Cuts Per Day (avg)</label><input id="f_cuts" type="number" placeholder="e.g. 4" oninput="autoCalc()"/></div>
          <div class="fg"><label>Avg Duration of Each Cut (hrs)</label><input id="f_cutdur" type="number" step="0.5" placeholder="e.g. 2"/></div>

          <div class="fsec-ttl">🏗️ Site & Installation Details</div>
          <div class="fg"><label>Available Area for Panels (sqft) *</label><input id="f_area" type="number" placeholder="e.g. 800" oninput="autoCalc()"/></div>
          <div class="fg"><label>Roof Type</label>
            <select id="f_roof"><option>RCC Flat Roof</option><option>Tin/Metal Sheet</option><option>Tiled Roof</option><option>Open Ground</option><option>Terrace</option></select></div>
          <div class="fg"><label>Property Type</label>
            <select id="f_prop"><option>Residential</option><option>Commercial</option><option>Industrial</option><option>Agricultural</option><option>Government</option></select></div>
          <div class="fg"><label>Grid Connectivity</label>
            <select id="f_grid"><option>Grid Available but Unreliable</option><option>No Grid (Remote Area)</option><option>Grid Available &amp; Stable</option></select></div>
          <div class="fg"><label>Preferred System Type *</label>
            <select id="f_sysopt" onchange="autoCalc()"><option value="offgrid">Offgrid Solar + Lithium Battery</option><option value="hybrid">Hybrid Solar + Lithium Battery</option><option value="unsure">Not Sure — Need Recommendation</option></select></div>
          <div class="fg"><label>Battery Preference</label>
            <select id="f_bat"><option>Lithium LiFePO4 (Recommended)</option><option>Lithium NMC</option><option>Lead Acid (Not Recommended)</option><option>No Battery</option></select></div>
          <div class="fg"><label>Budget Range (₹)</label>
