          <div class="fg"><label>Lead Status</label>
            <select id="f_status"><option value="cold">Cold</option><option value="warm">Warm</option><option value="hot">Hot</option><option value="converted">Converted</option></select></div>

          <div class="fsec-ttl full">⚙️ Auto Solar System Calculator</div>
