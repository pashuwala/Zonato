                <div class="co-item"><div class="co-val" id="co_kw">—</div><div class="co-lbl">System kW</div></div>
                <div class="co-item"><div class="co-val" id="co_pan">—</div><div class="co-lbl">Panels</div></div>
                <div class="co-item"><div class="co-val" id="co_batt">—</div><div class="co-lbl">Battery kWh</div></div>
                <div class="co-item"><div class="co-val" id="co_areaq">—</div><div class="co-lbl">Area Needed</div></div>
                <div class="co-item"><div class="co-val" id="co_days">—</div><div class="co-lbl">Install Days</div></div>
                <div class="co-item"><div class="co-val" id="co_cost">—</div><div class="co-lbl">Est. Cost</div></div>
                <div class="co-item"><div class="co-val" id="co_save">—</div><div class="co-lbl">Annual Savings</div></div>
                <div class="co-item"><div class="co-val" id="co_roi">—</div><div class="co-lbl">ROI (Years)</div></div>
                <div class="co-item"><div class="co-val" id="co_back">—</div><div class="co-lbl">Backup Hrs</div></div>
              </div>
            </div>
          </div>

          <div class="fsec-ttl full">📝 Notes & AI Recommendation</div>
          <div class="fg full"><label>Sales Notes</label><textarea id="f_notes" placeholder="Key points, customer requirements, follow-up actions..."></textarea></div>
          <div class="fg full"><label>AI Recommendation (auto-generated)</label><textarea id="f_airec" placeholder="Fill bill/units and click 'Recalculate' or it updates automatically..." style="height:100px;color:rgba(255,120,120,0.9);background:rgba(232,28,28,0.04);"></textarea></div>

          <div class="full" style="display:flex;gap:10px;justify-content:flex-end;padding-top:8px;">
            <button class="btn btn-o" type="button" onclick="goSec('leads',null)">Cancel</button>
