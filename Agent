function saveLead(){
  var name = (document.getElementById('f_name').value||'').trim();
  var phone = (document.getElementById('f_phone').value||'').trim();
  var location = (document.getElementById('f_location').value||'').trim();
  if(!name){ alert('Please enter customer name.'); return; }
