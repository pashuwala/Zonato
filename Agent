<!-- ═══ VIEW: CRM ═══ -->
<div class="view" id="v-crm">
<div class="crm-layout">
  <aside class="crm-side">
    <div class="side-title">CRM MENU</div>
    <div class="side-item on" onclick="goSec('leads',this)"><span class="si">👥</span>All Leads<span class="side-badge" id="totalBadge">0</span></div>
    <div class="side-item" onclick="goSec('add',this)"><span class="si">➕</span>Add Lead</div>
    <div class="side-item" onclick="goSec('hot',this)"><span class="si">🔥</span>Hot Leads<span class="side-badge" id="hotBadge">0</span></div>
    <div class="side-item" onclick="goSec('followup',this)"><span class="si">📅</span>Follow Ups</div>
    <div class="side-item" onclick="goSec('converted',this)"><span class="si">✅</span>Converted</div>
    <div class="side-divider"></div>
    <div class="side-title">TOOLS</div>
    <div class="side-item" onclick="goSec('calculator',this)"><span class="si">🔢</span>Solar Calc</div>
    <div class="side-item" onclick="goSec('notifications',this)"><span class="si">🔔</span>Notifications</div>
  </aside>

  <div class="crm-main">
    <!-- KPIs always visible -->
    <div class="kpi-row">
      <div class="kpi"><div class="kpi-ico">👥</div><div class="kpi-lbl">Total Leads</div><div class="kpi-val" id="k1">0</div><div class="kpi-sub" id="k1s">—</div></div>
      <div class="kpi"><div class="kpi-ico">🔥</div><div class="kpi-lbl">Hot Leads</div><div class="kpi-val" id="k2">0</div><div class="kpi-sub">Ready to close</div></div>
      <div class="kpi"><div class="kpi-ico">✅</div><div class="kpi-lbl">Converted</div><div class="kpi-val" id="k3">0</div><div class="kpi-sub">Deals closed</div></div>
      <div class="kpi"><div class="kpi-ico">💰</div><div class="kpi-lbl">Pipeline Value</div><div class="kpi-val" id="k4">₹0L</div><div class="kpi-sub">Total est. value</div></div>
    </div>

    <!-- ALL LEADS -->
    <div class="csec on" id="sec-leads">
      <div class="sec-hdr">
        <h2>ALL <span>LEADS</span></h2>
