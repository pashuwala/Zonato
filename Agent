<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Zonato Solar — AI CRM & Sales Bot</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Rajdhani:wght@400;500;600;700&family=Exo+2:wght@300;400;600;800&display=swap" rel="stylesheet"/>
<style>
:root{--red:#e81c1c;--red-dark:#b50e0e;--white:#fff;--dark:#1a0202;--dark2:#2d0505;--dark3:#0d0101;--card:rgba(255,255,255,0.03);--border:rgba(232,28,28,0.2);--text:rgba(255,255,255,0.75);--muted:rgba(255,255,255,0.38);--green:#22c55e;--amber:#f59e0b;--blue:#3b82f6;}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{font-family:'Exo 2',sans-serif;background:var(--dark3);color:#fff;overflow-x:hidden;min-height:100vh;}

/* scrollbar */
::-webkit-scrollbar{width:4px;height:4px;}
::-webkit-scrollbar-track{background:var(--dark);}
::-webkit-scrollbar-thumb{background:var(--red-dark);border-radius:2px;}

/* ── TOPBAR ── */
.topbar{position:fixed;top:0;left:0;right:0;height:58px;background:rgba(13,1,1,0.97);backdrop-filter:blur(16px);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 18px;z-index:600;}
.logo-wrap{display:flex;align-items:center;gap:10px;text-decoration:none;}
.logo-hex{width:34px;height:34px;background:var(--red);clip-path:polygon(50% 0%,100% 25%,100% 75%,50% 100%,0% 75%,0% 25%);display:flex;align-items:center;justify-content:center;position:relative;animation:spinpulse 8s linear infinite;}
.logo-hex::after{content:'☀';position:absolute;font-size:15px;animation:cspin 8s linear infinite;}
@keyframes spinpulse{0%,100%{transform:rotate(0deg)}50%{transform:rotate(180deg)}}
@keyframes cspin{from{transform:rotate(0deg)}to{transform:rotate(-360deg)}}
.logo-txt .ln{font-family:'Bebas Neue',sans-serif;font-size:19px;letter-spacing:3px;display:block;line-height:1;}
.logo-txt .ls{font-size:8px;letter-spacing:3px;color:var(--red);font-family:'Rajdhani',sans-serif;text-transform:uppercase;}
.tabs{display:flex;gap:2px;}
.tab{padding:7px 14px;background:transparent;border:none;cursor:pointer;font-family:'Rajdhani',sans-serif;font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);border-radius:3px;transition:all .2s;display:flex;align-items:center;gap:5px;}
.tab:hover{color:#fff;background:rgba(232,28,28,0.08);}
.tab.on{color:#fff;background:rgba(232,28,28,0.16);border:1px solid var(--border);}
.tab .dot{width:5px;height:5px;border-radius:50%;background:var(--muted);}
.tab.on .dot{background:var(--red);box-shadow:0 0 5px var(--red);}
.live-badge{display:flex;align-items:center;gap:6px;background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.3);padding:5px 12px;border-radius:2px;font-family:'Rajdhani',sans-serif;font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--green);}
.live-dot{width:6px;height:6px;border-radius:50%;background:var(--green);animation:blink 1.5s infinite;}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.2}}

/* ── VIEWS ── */
.view{display:none;padding-top:58px;min-height:100vh;}
.view.on{display:block;}

/* ══════════════════════════
   BOT VIEW
══════════════════════════ */
.bot-wrap{display:grid;grid-template-columns:1fr 420px;min-height:calc(100vh - 58px);background:linear-gradient(155deg,#1a0202 0%,#0d0101 55%,#1a0303 100%);position:relative;overflow:hidden;}
.bot-wrap::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(232,28,28,0.05) 1px,transparent 1px),linear-gradient(90deg,rgba(232,28,28,0.05) 1px,transparent 1px);background-size:55px 55px;pointer-events:none;}
.bot-left{padding:70px 55px;display:flex;flex-direction:column;justify-content:center;position:relative;z-index:1;}
.bot-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(232,28,28,0.1);border:1px solid rgba(232,28,28,0.3);padding:5px 14px;border-radius:2px;font-family:'Rajdhani',sans-serif;font-size:11px;letter-spacing:3px;text-transform:uppercase;color:var(--red);margin-bottom:22px;}
.bot-h1{font-family:'Bebas Neue',sans-serif;font-size:clamp(46px,6vw,84px);line-height:.9;letter-spacing:2px;margin-bottom:18px;}
.bot-h1 em{font-style:normal;background:linear-gradient(90deg,var(--red),#ff6060,var(--red));background-size:200%;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;animation:gsh 3s ease infinite;}
@keyframes gsh{0%{background-position:0%}50%{background-position:100%}100%{background-position:0%}}
.bot-p{font-size:14px;color:var(--text);line-height:1.75;max-width:460px;margin-bottom:30px;}
.bot-stats{display:flex;gap:16px;flex-wrap:wrap;}
.bstat{text-align:center;padding:14px 18px;background:rgba(232,28,28,0.06);border:1px solid var(--border);border-radius:3px;}
.bstat .n{font-family:'Bebas Neue',sans-serif;font-size:30px;color:var(--red);}
.bstat .l{font-family:'Rajdhani',sans-serif;font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);}

/* chat panel */
.chat-panel{background:rgba(13,1,1,0.97);border-left:1px solid var(--border);display:flex;flex-direction:column;height:calc(100vh - 58px);position:sticky;top:58px;}
.chat-hdr{padding:14px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-shrink:0;}
.agent-wrap{display:flex;align-items:center;gap:11px;}
.agent-av{width:38px;height:38px;background:var(--red);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:17px;position:relative;}
.agent-av::after{content:'';position:absolute;bottom:1px;right:1px;width:9px;height:9px;background:var(--green);border-radius:50%;border:2px solid #0d0101;}
.agent-nm{font-family:'Rajdhani',sans-serif;font-weight:700;font-size:14px;letter-spacing:1px;}
.agent-st{font-size:10px;color:var(--green);letter-spacing:.5px;}
.chat-msgs{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:10px;}
.msg{max-width:86%;display:flex;flex-direction:column;gap:3px;}
.msg.bot{align-self:flex-start;}.msg.user{align-self:flex-end;}
.msg-bub{padding:10px 14px;border-radius:3px;font-size:13px;line-height:1.65;}
.msg.bot .msg-bub{background:rgba(232,28,28,0.08);border:1px solid rgba(232,28,28,0.18);color:var(--text);}
.msg.user .msg-bub{background:var(--red);color:#fff;}
.msg-time{font-size:9px;color:var(--muted);font-family:'Rajdhani',sans-serif;letter-spacing:1px;}
.msg.user .msg-time{text-align:right;}
.qr-row{display:flex;flex-wrap:wrap;gap:5px;padding:0 14px 8px;flex-shrink:0;}
.qr{padding:5px 11px;background:rgba(232,28,28,0.07);border:1px solid rgba(232,28,28,0.22);border-radius:2px;font-family:'Rajdhani',sans-serif;font-size:11px;font-weight:600;color:rgba(255,255,255,0.65);cursor:pointer;transition:all .2s;}
.qr:hover{background:rgba(232,28,28,0.18);color:#fff;border-color:rgba(232,28,28,0.5);}
.chat-inp-row{padding:10px 14px;border-top:1px solid var(--border);display:flex;gap:7px;flex-shrink:0;}
.chat-inp{flex:1;padding:9px 13px;background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:2px;color:#fff;font-family:'Exo 2',sans-serif;font-size:13px;outline:none;transition:border-color .2s;}
.chat-inp:focus{border-color:var(--red);}
.chat-send{padding:9px 15px;background:var(--red);border:none;color:#fff;font-size:15px;cursor:pointer;border-radius:2px;transition:background .2s;}
.chat-send:hover{background:var(--red-dark);}
.typing-bub{display:flex;gap:4px;padding:10px 14px;align-items:center;}
.typing-bub span{width:6px;height:6px;border-radius:50%;background:var(--red);animation:tdot 1.2s infinite;}
.typing-bub span:nth-child(2){animation-delay:.2s;}
.typing-bub span:nth-child(3){animation-delay:.4s;}
@keyframes tdot{0%,80%,100%{transform:scale(0.6);opacity:.4}40%{transform:scale(1);opacity:1}}
/* proposal card in chat */
.prop-card{background:rgba(232,28,28,0.06);border:1px solid var(--border);border-radius:4px;padding:12px;margin:3px 0;font-size:12px;}
.prop-card .pc-ttl{font-family:'Rajdhani',sans-serif;font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--red);margin-bottom:9px;}
.prop-row{display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px solid rgba(232,28,28,0.08);}
.prop-row:last-child{border-bottom:none;}
.prop-row .pk{color:var(--muted);font-size:11px;}
.prop-row .pv{font-family:'Rajdhani',sans-serif;font-weight:700;font-size:13px;color:#fff;}
.prop-row .pv.red{color:var(--red);}
.prop-btns{display:flex;gap:6px;margin-top:9px;}
.prop-btns a{flex:1;padding:7px;text-align:center;font-family:'Rajdhani',sans-serif;font-weight:700;font-size:11px;letter-spacing:1.5px;text-decoration:none;border-radius:2px;}
.prop-btns .pb-call{background:var(--red);color:#fff;}
.prop-btns .pb-wa{background:#25D366;color:#fff;}

/* ══════════════════════════
   CRM LAYOUT
══════════════════════════ */
.crm-layout{display:grid;grid-template-columns:210px 1fr;min-height:calc(100vh - 58px);}
.crm-side{background:rgba(13,1,1,0.97);border-right:1px solid var(--border);padding:16px 0;position:sticky;top:58px;height:calc(100vh - 58px);overflow-y:auto;flex-shrink:0;}
.side-title{padding:0 16px 10px;font-family:'Rajdhani',sans-serif;font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--muted);}
.side-item{display:flex;align-items:center;gap:9px;padding:9px 16px;cursor:pointer;font-family:'Rajdhani',sans-serif;font-size:12px;font-weight:600;letter-spacing:.5px;color:var(--muted);transition:all .2s;border-left:2px solid transparent;}
.side-item:hover{color:#fff;background:rgba(232,28,28,0.06);}
.side-item.on{color:#fff;background:rgba(232,28,28,0.1);border-left-color:var(--red);}
.side-item .si{font-size:14px;}
.side-badge{margin-left:auto;background:var(--red);color:#fff;font-size:10px;padding:1px 6px;border-radius:8px;font-family:'Bebas Neue',sans-serif;}
.side-divider{height:1px;background:var(--border);margin:8px 0;}
.crm-main{padding:24px;background:var(--dark3);overflow-y:auto;}

/* KPI row */
.kpi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:24px;}
.kpi{background:var(--card);border:1px solid var(--border);border-radius:4px;padding:18px;position:relative;overflow:hidden;transition:border-color .3s;}
.kpi:hover{border-color:rgba(232,28,28,0.4);}
.kpi::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--red),transparent);}
.kpi-lbl{font-family:'Rajdhani',sans-serif;font-size:9px;letter-spacing:2.5px;text-transform:uppercase;color:var(--muted);margin-bottom:6px;}
.kpi-val{font-family:'Bebas Neue',sans-serif;font-size:36px;color:#fff;line-height:1;}
.kpi-sub{font-size:11px;color:var(--muted);margin-top:4px;}
.kpi-ico{position:absolute;right:14px;top:14px;font-size:24px;opacity:.15;}

/* section header */
.sec-hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;flex-wrap:wrap;gap:10px;}
.sec-hdr h2{font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:2px;}
.sec-hdr h2 span{color:var(--red);}
.sec-hdr .hdr-right{display:flex;gap:8px;align-items:center;flex-wrap:wrap;}

/* buttons */
.btn{padding:8px 18px;border:none;cursor:pointer;font-family:'Rajdhani',sans-serif;font-weight:700;font-size:12px;letter-spacing:1.5px;text-transform:uppercase;border-radius:2px;transition:all .2s;display:inline-flex;align-items:center;gap:5px;}
.btn-r{background:var(--red);color:#fff;}.btn-r:hover{background:var(--red-dark);box-shadow:0 0 14px rgba(232,28,28,0.4);}
.btn-o{background:transparent;border:1px solid var(--border);color:var(--muted);}.btn-o:hover{border-color:var(--red);color:#fff;}

/* search */
.search-inp{padding:8px 13px;background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:2px;color:#fff;font-family:'Exo 2',sans-serif;font-size:12px;outline:none;width:180px;transition:border-color .2s;}
.search-inp:focus{border-color:var(--red);}

/* table */
.tbl-wrap{overflow-x:auto;border:1px solid var(--border);border-radius:4px;}
table{width:100%;border-collapse:collapse;font-size:12px;}
thead tr{background:rgba(232,28,28,0.08);}
th{padding:10px 12px;text-align:left;font-family:'Rajdhani',sans-serif;font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--border);white-space:nowrap;}
td{padding:10px 12px;border-bottom:1px solid rgba(232,28,28,0.06);color:var(--text);vertical-align:middle;}
tr:hover td{background:rgba(232,28,28,0.04);}
tr:last-child td{border-bottom:none;}
/* status badges */
.st{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:2px;font-family:'Rajdhani',sans-serif;font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;}
.st::before{content:'';width:4px;height:4px;border-radius:50%;background:currentColor;}
.st.hot{background:rgba(232,28,28,0.15);color:var(--red);border:1px solid rgba(232,28,28,0.3);}
.st.warm{background:rgba(245,158,11,0.12);color:var(--amber);border:1px solid rgba(245,158,11,0.3);}
.st.cold{background:rgba(59,130,246,0.12);color:var(--blue);border:1px solid rgba(59,130,246,0.3);}
.st.converted{background:rgba(34,197,94,0.12);color:var(--green);border:1px solid rgba(34,197,94,0.3);}
/* score bar */
.sbar{width:70px;height:5px;background:rgba(255,255,255,0.08);border-radius:3px;overflow:hidden;display:inline-block;}
.sbar-f{height:100%;border-radius:3px;background:linear-gradient(90deg,var(--red-dark),var(--red));}
/* table action buttons */
.ta{padding:3px 9px;background:rgba(232,28,28,0.08);border:1px solid rgba(232,28,28,0.2);border-radius:2px;color:var(--muted);font-family:'Rajdhani',sans-serif;font-size:10px;font-weight:600;cursor:pointer;transition:all .2s;}
.ta:hover{background:rgba(232,28,28,0.2);color:#fff;border-color:rgba(232,28,28,0.5);}

/* CRM sections */
.csec{display:none;}.csec.on{display:block;}

/* form */
.card-box{background:var(--card);border:1px solid var(--border);border-radius:4px;padding:22px;}
.fg{display:flex;flex-direction:column;gap:5px;margin-bottom:14px;}
.fg label{font-family:'Rajdhani',sans-serif;font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);}
.fg input,.fg select,.fg textarea{padding:9px 13px;background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:2px;color:#fff;font-family:'Exo 2',sans-serif;font-size:13px;outline:none;transition:border-color .2s;width:100%;}
.fg input:focus,.fg select:focus,.fg textarea:focus{border-color:var(--red);}
.fg select option{background:#1a0202;}
.fg textarea{resize:none;height:80px;}
.fgrid{display:grid;grid-template-columns:1fr 1fr;gap:0 16px;}
.fgrid .full{grid-column:1/-1;}
.fsec-ttl{grid-column:1/-1;font-family:'Bebas Neue',sans-serif;font-size:15px;letter-spacing:3px;color:var(--red);padding:10px 0 8px;border-bottom:1px solid var(--border);margin-top:8px;}

/* calc box */
.calc-box{background:rgba(232,28,28,0.05);border:1px solid var(--border);border-radius:4px;padding:14px;margin-top:4px;}
.calc-box .cb-ttl{font-family:'Rajdhani',sans-serif;font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--red);margin-bottom:10px;}
.calc-out{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:10px;}
.co-item{background:rgba(255,255,255,0.03);border:1px solid rgba(232,28,28,0.1);border-radius:3px;padding:8px 10px;text-align:center;}
.co-val{font-family:'Bebas Neue',sans-serif;font-size:20px;color:var(--red);line-height:1;}
.co-lbl{font-size:9px;color:var(--muted);font-family:'Rajdhani',sans-serif;letter-spacing:1px;text-transform:uppercase;margin-top:2px;}

/* lead detail */
.ld-panel{background:rgba(18,1,1,0.98);border:1px solid var(--border);border-radius:4px;margin-top:18px;display:none;}
.ld-panel.on{display:block;}
.ld-hdr{padding:14px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:14px;flex-wrap:wrap;}
.ld-av{width:44px;height:44px;background:var(--red);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;font-size:19px;flex-shrink:0;}
.ld-nm{font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:1.5px;}
.ld-sub{font-size:11px;color:var(--muted);margin-top:1px;}
.ld-cols{display:grid;grid-template-columns:repeat(3,1fr);}
.ld-col{padding:14px 18px;border-right:1px solid var(--border);}
.ld-col:last-child{border-right:none;}
.ld-col-ttl{font-family:'Rajdhani',sans-serif;font-size:9px;letter-spacing:2.5px;text-transform:uppercase;color:var(--red);margin-bottom:10px;}
.ldf{margin-bottom:9px;}
.ldf .fk{font-size:10px;color:var(--muted);margin-bottom:1px;}
.ldf .fv{font-size:13px;color:#fff;font-weight:600;}
.ai-box{background:rgba(232,28,28,0.06);border:1px solid rgba(232,28,28,0.22);border-left:3px solid var(--red);border-radius:0 4px 4px 0;padding:11px 14px;margin:10px 18px;font-size:12px;line-height:1.7;color:var(--text);}
.ai-box .ai-lbl{font-family:'Rajdhani',sans-serif;font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--red);margin-bottom:5px;}

/* follow-up form */
.fu-form{padding:14px 18px;border-bottom:1px solid var(--border);background:rgba(232,28,28,0.04);display:none;}
.fu-form .fu-ttl{font-family:'Rajdhani',sans-serif;font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--red);margin-bottom:9px;}
.fu-row{display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;}
.fu-row input{padding:7px 10px;background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:2px;color:#fff;font-size:12px;outline:none;}
.fu-row input:focus{border-color:var(--red);}

/* pipeline */
.pipe-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-top:16px;}
.pipe-col{background:rgba(255,255,255,0.02);border:1px solid var(--border);border-radius:4px;overflow:hidden;}
.pipe-hdr{padding:9px 12px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;}
.pipe-ttl{font-family:'Rajdhani',sans-serif;font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;}
.pipe-cnt{background:rgba(232,28,28,0.15);color:var(--red);font-family:'Bebas Neue',sans-serif;font-size:15px;padding:0 7px;border-radius:2px;}
.pipe-cards{padding:9px;display:flex;flex-direction:column;gap:7px;min-height:80px;}
.p-card{background:rgba(255,255,255,0.03);border:1px solid rgba(232,28,28,0.1);border-radius:3px;padding:9px 10px;cursor:pointer;transition:all .2s;}
.p-card:hover{border-color:rgba(232,28,28,0.4);background:rgba(232,28,28,0.06);}
.p-card .pcn{font-family:'Rajdhani',sans-serif;font-weight:700;font-size:12px;}
.p-card .pci{font-size:10px;color:var(--muted);}
.p-card .pcv{font-family:'Bebas Neue',sans-serif;font-size:14px;color:var(--red);}

/* analytics */
.an-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px;}
.an-card{background:var(--card);border:1px solid var(--border);border-radius:4px;padding:18px;}
.an-card h4{font-family:'Bebas Neue',sans-serif;font-size:17px;letter-spacing:1.5px;margin-bottom:14px;}
.an-card h4 span{color:var(--red);}
.bar-r{display:flex;align-items:center;gap:8px;margin-bottom:7px;}
.bar-lbl{font-size:10px;color:var(--muted);width:110px;flex-shrink:0;font-family:'Rajdhani',sans-serif;}
.bar-trk{flex:1;height:7px;background:rgba(255,255,255,0.06);border-radius:3px;overflow:hidden;}
.bar-fl{height:100%;border-radius:3px;background:linear-gradient(90deg,var(--red-dark),var(--red));transition:width 1s;}
.bar-v{font-family:'Bebas Neue',sans-serif;font-size:13px;color:var(--red);width:30px;text-align:right;}

/* notif */
.notif-item{display:flex;gap:11px;padding:11px 0;border-bottom:1px solid rgba(232,28,28,0.07);}
.notif-item:last-child{border-bottom:none;}
.n-ico{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0;}
.n-ico.r{background:rgba(232,28,28,0.15);}
.n-ico.g{background:rgba(34,197,94,0.15);}
.n-ico.a{background:rgba(245,158,11,0.15);}
.n-ttl{font-size:13px;color:#fff;margin-bottom:2px;}
.n-tm{font-size:10px;color:var(--muted);font-family:'Rajdhani',sans-serif;letter-spacing:.5px;}

/* alert/info boxes */
.info-box{background:rgba(232,28,28,0.06);border:1px solid rgba(232,28,28,0.2);border-radius:4px;padding:14px 18px;margin-bottom:14px;}
.info-box .ib-ttl{font-family:'Rajdhani',sans-serif;font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--red);margin-bottom:6px;}
.info-box p{font-size:13px;color:var(--text);line-height:1.7;}

/* standalone calc */
.sc-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;}
.sc-res-item{background:rgba(255,255,255,0.03);border:1px solid rgba(232,28,28,0.1);border-radius:3px;padding:9px 12px;}
.sc-res-item .rv{font-family:'Bebas Neue',sans-serif;font-size:20px;color:var(--red);line-height:1;}
.sc-res-item .rl{font-size:9px;color:var(--muted);font-family:'Rajdhani',sans-serif;letter-spacing:1.5px;text-transform:uppercase;margin-top:2px;}

@media(max-width:1100px){.bot-wrap{grid-template-columns:1fr;}.chat-panel{height:480px;position:static;}}
@media(max-width:900px){.crm-layout{grid-template-columns:1fr;}.crm-side{position:static;height:auto;display:flex;flex-wrap:wrap;padding:8px;border-right:none;border-bottom:1px solid var(--border);}.crm-side .side-item{padding:6px 10px;}.pipe-grid{grid-template-columns:repeat(2,1fr);}.kpi-row{grid-template-columns:repeat(2,1fr);}.an-grid{grid-template-columns:1fr;}}
@media(max-width:600px){.fgrid{grid-template-columns:1fr;}.ld-cols{grid-template-columns:1fr;}.calc-out{grid-template-columns:1fr 1fr;}.sc-grid{grid-template-columns:1fr;}.tabs{display:none;}}
</style>
</head>
