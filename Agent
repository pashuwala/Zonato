  extractHints(userMsg);

  try {
    var resp = await fetch('https://api.anthropic.com/v1/messages',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({
        model:'claude-sonnet-4-20250514',
        max_tokens:900,
        system:SYSTEM_PROMPT,
        messages:chatHist
      })
    });
    var data = await resp.json();
    hideTyping();
    var reply = '';
    if(data.content && data.content.length){
      reply = data.content.map(function(c){return c.text||'';}).join('');
    } else {
      reply = "I'm having a moment — please try again! You can also call us directly at **+91 89823 79366** ⚡";
    }
    chatHist.push({role:'assistant',content:reply});
    addMsg('bot', reply);

