  <style>
    :root {
      --red: #e81c1c;
      --red-dark: #b50e0e;
      --red-glow: #ff2a2a;
      --white: #ffffff;
      --off-white: #f9f3f3;
      --dark: #1a0202;
      --dark2: #2d0505;
      --mid: #5a0a0a;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      font-family: 'Exo 2', sans-serif;
      background: var(--dark);
      color: var(--white);
      overflow-x: hidden;
    }

    /* Noise overlay */
    body::before {
      content: '';
      position: fixed; inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
      pointer-events: none; z-index: 9999; opacity: .35;
    }

    /* ── NAVBAR ── */
    nav {
      position: fixed; top: 0; width: 100%; z-index: 1000;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 5%; height: 72px;
      background: rgba(26,2,2,0.94);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid rgba(232,28,28,0.25);
    }

    .nav-logo {
      display: flex; align-items: center; gap: 12px;
      text-decoration: none;
    }

    .logo-icon {
      width: 40px; height: 40px;
      background: var(--red);
      clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
      display: flex; align-items: center; justify-content: center;
      font-size: 17px; position: relative;
      animation: spin-pulse 8s linear infinite;
    }

    .logo-icon::after {
      content: '☀';
      position: absolute; font-size: 19px;
      animation: counter-spin 8s linear infinite;
    }

    @keyframes spin-pulse {
      0%,100% { transform: rotate(0deg) scale(1); }
      50% { transform: rotate(180deg) scale(1.08); }
    }
    @keyframes counter-spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(-360deg); }
    }

    .logo-text .brand {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 24px; letter-spacing: 3px; color: var(--white);
      display: block; line-height: 1;
    }
    .logo-text .tagline {
      font-size: 9px; letter-spacing: 4px; color: var(--red);
      text-transform: uppercase; font-family: 'Rajdhani', sans-serif;
    }

    .nav-back {
      display: flex; align-items: center; gap: 8px;
      color: rgba(255,255,255,0.6);
      text-decoration: none;
      font-family: 'Rajdhani', sans-serif;
      font-size: 13px; letter-spacing: 2px; text-transform: uppercase;
      transition: color .2s;
      border: 1px solid rgba(232,28,28,0.2);
      padding: 8px 18px; border-radius: 2px;
    }
    .nav-back:hover { color: var(--red); border-color: rgba(232,28,28,0.5); }

    /* ── HERO BANNER ── */
    .page-hero {
      padding: 72px 0 0;
      position: relative; overflow: hidden;
      min-height: 280px;
      display: flex; align-items: flex-end;
    }

    .page-hero-bg {
      position: absolute; inset: 0;
      background:
        radial-gradient(ellipse 70% 80% at 20% 50%, rgba(232,28,28,0.14) 0%, transparent 60%),
        linear-gradient(160deg, #1a0202 0%, #0d0101 100%);
    }

    .page-hero-bg::before {
      content: '';
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(232,28,28,0.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(232,28,28,0.06) 1px, transparent 1px);
      background-size: 60px 60px;
    }

    .page-hero-bg::after {
      content: 'T&C';
      position: absolute; right: 5%; top: 50%; transform: translateY(-50%);
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(100px, 18vw, 220px);
      color: rgba(232,28,28,0.05);
      letter-spacing: 10px;
      pointer-events: none;
    }

    .page-hero-inner {
      position: relative; z-index: 1;
      max-width: 1200px; margin: 0 auto;
      padding: 48px 5% 52px;
      width: 100%;
    }

    .breadcrumb {
      display: flex; align-items: center; gap: 8px;
      font-family: 'Rajdhani', sans-serif;
      font-size: 12px; letter-spacing: 2px; text-transform: uppercase;
      color: rgba(255,255,255,0.35);
      margin-bottom: 16px;
    }
    .breadcrumb a { color: var(--red); text-decoration: none; }
    .breadcrumb span { color: rgba(255,255,255,0.35); }

    .page-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(40px, 6vw, 80px);
      line-height: .95; letter-spacing: 2px;
    }

    .page-title span { color: var(--red); }

    .page-meta {
      display: flex; gap: 24px; flex-wrap: wrap;
      margin-top: 20px;
    }

    .meta-pill {
      display: inline-flex; align-items: center; gap: 7px;
      background: rgba(232,28,28,0.08);
      border: 1px solid rgba(232,28,28,0.2);
      padding: 6px 14px; border-radius: 2px;
      font-family: 'Rajdhani', sans-serif;
      font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase;
      color: rgba(255,255,255,0.6);
    }
    .meta-pill strong { color: var(--red); font-weight: 700; }

    /* Divider line */
    .divider-line {
      width: 100%; height: 1px;
      background: linear-gradient(90deg, transparent, rgba(232,28,28,0.4), transparent);
    }

    /* ── TABLE OF CONTENTS ── */
    .toc-wrap {
      background: rgba(232,28,28,0.04);
      border: 1px solid rgba(232,28,28,0.18);
      border-left: 3px solid var(--red);
      border-radius: 0 4px 4px 0;
      padding: 28px 32px;
      margin-bottom: 48px;
    }

    .toc-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 20px; letter-spacing: 3px;
      color: var(--red); margin-bottom: 18px;
    }

    .toc-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 8px 32px;
    }

    .toc-item {
      display: flex; align-items: center; gap: 10px;
      text-decoration: none;
      font-family: 'Rajdhani', sans-serif;
      font-size: 14px; font-weight: 600; letter-spacing: .5px;
      color: rgba(255,255,255,0.6);
      padding: 6px 0;
      border-bottom: 1px solid rgba(232,28,28,0.08);
      transition: color .2s;
    }
    .toc-item:hover { color: var(--white); }
    .toc-item .toc-num {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 15px; color: var(--red);
      min-width: 28px;
    }

    /* ── MAIN LAYOUT ── */
    .main-wrap {
      max-width: 1200px; margin: 0 auto;
      padding: 60px 5% 80px;
      display: grid;
      grid-template-columns: 260px 1fr;
      gap: 56px;
      align-items: start;
    }

    /* ── STICKY SIDEBAR ── */
    .sidebar {
      position: sticky; top: 88px;
    }

    .sidebar-nav {
      background: rgba(232,28,28,0.04);
      border: 1px solid rgba(232,28,28,0.15);
      border-radius: 4px; overflow: hidden;
    }

    .sidebar-header {
      background: var(--red);
      padding: 14px 18px;
      font-family: 'Bebas Neue', sans-serif;
      font-size: 16px; letter-spacing: 3px;
    }

    .sidebar-link {
      display: flex; align-items: center; gap: 10px;
      padding: 11px 18px;
      text-decoration: none;
      font-family: 'Rajdhani', sans-serif;
      font-size: 13px; font-weight: 600; letter-spacing: .5px;
      color: rgba(255,255,255,0.55);
      border-bottom: 1px solid rgba(232,28,28,0.08);
      transition: background .2s, color .2s, border-left .2s;
      border-left: 2px solid transparent;
    }
    .sidebar-link:hover, .sidebar-link.active {
      background: rgba(232,28,28,0.08);
      color: var(--white);
      border-left-color: var(--red);
    }
    .sidebar-link .s-num {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 14px; color: var(--red); min-width: 22px;
    }

    .sidebar-contact {
      margin-top: 20px;
      background: rgba(232,28,28,0.06);
      border: 1px solid rgba(232,28,28,0.2);
      border-radius: 4px; padding: 20px;
    }

    .sidebar-contact h6 {
      font-family: 'Rajdhani', sans-serif;
      font-size: 11px; letter-spacing: 3px; text-transform: uppercase;
      color: var(--red); margin-bottom: 14px;
    }

    .sidebar-contact a {
      display: flex; align-items: center; gap: 8px;
      color: rgba(255,255,255,0.7); text-decoration: none;
      font-size: 13px; margin-bottom: 10px;
      transition: color .2s;
    }
    .sidebar-contact a:hover { color: var(--white); }

    /* ── CONTENT ── */
    .content { }

    .law-notice {
      background: rgba(232,28,28,0.07);
      border: 1px solid rgba(232,28,28,0.25);
      border-left: 4px solid var(--red);
      border-radius: 0 4px 4px 0;
      padding: 18px 22px;
      margin-bottom: 44px;
      display: flex; gap: 14px; align-items: flex-start;
    }

    .law-notice .notice-icon { font-size: 22px; flex-shrink: 0; margin-top: 1px; }

    .law-notice p {
      font-size: 13px; color: rgba(255,255,255,0.65); line-height: 1.7;
    }
    .law-notice p strong { color: var(--white); }

    /* Section blocks */
    .tc-section {
      margin-bottom: 56px;
      scroll-margin-top: 88px;
    }

    .tc-section-header {
      display: flex; align-items: center; gap: 16px;
      margin-bottom: 24px;
      padding-bottom: 14px;
      border-bottom: 1px solid rgba(232,28,28,0.18);
    }

    .tc-section-num {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 36px; color: rgba(232,28,28,0.35);
      line-height: 1; min-width: 48px;
    }

    .tc-section-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(20px, 2.5vw, 30px);
      letter-spacing: 2px; color: var(--white);
    }

    .tc-section-title span { color: var(--red); }

    .tc-section-icon {
      margin-left: auto;
      font-size: 26px;
      opacity: 0.7;
    }

    .tc-body {
      font-size: 14.5px; color: rgba(255,255,255,0.65);
      line-height: 1.85;
    }

    .tc-body p { margin-bottom: 14px; }
    .tc-body p:last-child { margin-bottom: 0; }

    .tc-body strong { color: rgba(255,255,255,0.9); font-weight: 600; }

    .tc-body a {
      color: var(--red); text-decoration: none;
      border-bottom: 1px solid rgba(232,28,28,0.3);
      transition: border-color .2s;
    }
    .tc-body a:hover { border-color: var(--red); }

    /* Clause list */
    .clause-list {
      list-style: none; margin: 16px 0;
      display: flex; flex-direction: column; gap: 10px;
    }

    .clause-list li {
      display: flex; align-items: flex-start; gap: 12px;
      font-size: 14px; color: rgba(255,255,255,0.65); line-height: 1.75;
      padding: 12px 16px;
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(232,28,28,0.08);
      border-radius: 2px;
      transition: border-color .2s, background .2s;
    }

    .clause-list li:hover {
      border-color: rgba(232,28,28,0.22);
      background: rgba(232,28,28,0.04);
    }

    .clause-list li::before {
      content: '▸';
      color: var(--red); font-size: 11px; flex-shrink: 0; margin-top: 3px;
    }

    .clause-list li strong { color: rgba(255,255,255,0.88); }

    /* Sub-numbered list */
    .numbered-list {
      counter-reset: clause;
      list-style: none; margin: 16px 0;
      display: flex; flex-direction: column; gap: 8px;
    }

    .numbered-list li {
      counter-increment: clause;
      display: flex; gap: 12px;
      font-size: 14px; color: rgba(255,255,255,0.65); line-height: 1.75;
      padding: 10px 14px;
      background: rgba(232,28,28,0.03);
      border-left: 2px solid rgba(232,28,28,0.15);
    }

    .numbered-list li::before {
      content: counter(clause, decimal-leading-zero) '.';
      font-family: 'Bebas Neue', sans-serif;
      font-size: 15px; color: rgba(232,28,28,0.6);
      flex-shrink: 0; min-width: 30px;
    }

    /* Highlight box */
    .highlight-box {
      background: rgba(232,28,28,0.06);
      border: 1px solid rgba(232,28,28,0.22);
      border-radius: 4px; padding: 22px 26px;
      margin: 20px 0;
    }

    .highlight-box .hb-title {
      font-family: 'Rajdhani', sans-serif;
      font-size: 12px; letter-spacing: 3px; text-transform: uppercase;
      color: var(--red); margin-bottom: 10px;
    }

    .highlight-box p {
      font-size: 14px; color: rgba(255,255,255,0.65); line-height: 1.75;
    }

    .highlight-box p strong { color: var(--white); }

    /* Warning box */
    .warning-box {
      background: rgba(232,28,28,0.1);
      border: 1px solid rgba(232,28,28,0.35);
      border-left: 4px solid var(--red);
      border-radius: 0 4px 4px 0;
      padding: 18px 22px; margin: 20px 0;
      display: flex; gap: 12px; align-items: flex-start;
    }

    .warning-box .wb-icon { font-size: 20px; flex-shrink: 0; }

    .warning-box p {
      font-size: 13.5px; color: rgba(255,255,255,0.7); line-height: 1.7;
    }

    .warning-box p strong { color: var(--white); }

    /* Info table */
    .info-table {
      width: 100%; border-collapse: collapse; margin: 18px 0;
      font-size: 13.5px;
    }

    .info-table thead {
      background: rgba(232,28,28,0.15);
    }

    .info-table th {
      padding: 12px 16px; text-align: left;
      font-family: 'Rajdhani', sans-serif;
      font-size: 12px; letter-spacing: 2px; text-transform: uppercase;
      color: rgba(255,255,255,0.9);
      border-bottom: 1px solid rgba(232,28,28,0.3);
    }

    .info-table td {
      padding: 11px 16px;
      color: rgba(255,255,255,0.65);
      border-bottom: 1px solid rgba(232,28,28,0.08);
      line-height: 1.6;
    }

    .info-table tr:hover td { background: rgba(232,28,28,0.04); }

    .info-table td strong { color: rgba(255,255,255,0.85); }

    /* Reveal animation */
    .reveal {
      opacity: 0; transform: translateY(30px);
      transition: opacity .6s ease, transform .6s ease;
    }
    .reveal.visible { opacity: 1; transform: translateY(0); }

    /* ── FOOTER ── */
    footer {
      background: #0a0101;
      border-top: 1px solid rgba(232,28,28,0.2);
    }

    .footer-bottom {
      max-width: 1200px; margin: auto;
      padding: 28px 5%;
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 16px;
    }

    .footer-bottom p {
      font-size: 12px; color: rgba(255,255,255,0.3);
      font-family: 'Rajdhani', sans-serif; letter-spacing: 1px;
    }

    .footer-bottom p span { color: var(--red); }

    .footer-links-row { display: flex; gap: 20px; }
    .footer-links-row a {
      font-family: 'Rajdhani', sans-serif;
      font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase;
      color: rgba(255,255,255,0.35); text-decoration: none;
      transition: color .2s;
    }
    .footer-links-row a:hover { color: var(--red); }

    /* WhatsApp float */
    .wa-float {
      position: fixed; bottom: 28px; right: 28px; z-index: 2000;
      width: 52px; height: 52px;
      background: #25D366; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 24px; text-decoration: none;
      box-shadow: 0 4px 20px rgba(37,211,102,0.5);
      animation: wa-bounce 2s ease-in-out infinite;
    }
    @keyframes wa-bounce { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-6px)} }

    /* Progress bar */
    .reading-progress {
      position: fixed; top: 72px; left: 0; right: 0;
      height: 2px; background: transparent; z-index: 999;
    }
    .reading-progress-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--red-dark), var(--red), #ff6b6b);
      width: 0%; transition: width .1s;
    }

    /* Responsive */
    @media (max-width: 900px) {
      .main-wrap { grid-template-columns: 1fr; }
      .sidebar { position: static; display: none; }
    }

    @media (max-width: 600px) {
      .toc-grid { grid-template-columns: 1fr; }
      .page-meta { flex-direction: column; gap: 10px; }
      .footer-bottom { flex-direction: column; text-align: center; }
    }
  </style>
</head>
